{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cartucho Music",
  "version": "1.0.5",
  "identifier": "site.cartucho.music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cartucho Music",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' https://sdk.scdn.co",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https://i.scdn.co https://*.scdn.co https://*.spotifycdn.com",
        "media-src": "'self' blob: https://*.scdn.co",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.spotify.com https://*.scdn.co https://*.spotify.com wss://*.spotify.com",
        "frame-src": "https://sdk.scdn.co https://*.spotify.com",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Cartucho Music",
    "copyright": "© 2026 Cartucho Music",
    "category": "Music",
    "shortDescription": "Reproductor musical de escritorio",
    "longDescription": "Cartucho Music es un cliente de escritorio para tus servicios de música, con una interfaz propia y personalizable.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlENzM0RTg2QjU1RjgzMDYKUldRR2cxKzFoazV6bmVTN0RzTjdyOG43c3dTYjY2WWNhQmpUOXhPcEZrcDlNUGhvQXlHd3I1YzgK",
      "endpoints": [
        "https://github.com/Piscuish/cartucho-music/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
