{
    "name": "cartucho-music",
    "private": true,
    "version": "1.0.7",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --noEmit",
        "test": "vitest run",
        "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
        "tauri": "tauri",
        "test:coverage": "vitest run --coverage",
        "check": "tsc -b && tsc -p installer && vitest run && cargo test --manifest-path src-tauri/Cargo.toml && cargo test --manifest-path installer/src-tauri/Cargo.toml",
        "installer:dev": "vite --config installer/vite.config.ts",
        "installer:build": "tsc -p installer && vite build --config installer/vite.config.ts",
        "installer:tauri": "cd installer && tauri"
    },
    "dependencies": {
        "@fontsource/fraunces": "^5.3.0",
        "@fontsource/inter": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fontsource/space-grotesk": "^5.3.0",
        "@tanstack/react-query": "^5.107.1",
        "@tanstack/react-virtual": "^3.14.26",
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-autostart": "^2.7.0",
        "@tauri-apps/plugin-global-shortcut": "^2.4.1",
        "@tauri-apps/plugin-notification": "^2.8.1",
        "@tauri-apps/plugin-opener": "^2.7.3",
        "@tauri-apps/plugin-process": "^2.4.0",
        "@tauri-apps/plugin-updater": "^2.14.1",
        "clsx": "^2.1.1",
        "framer-motion": "^14.14.0",
        "lucide-react": "^1.73.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5",
        "zod": "^4.6.7",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@tauri-apps/cli": "^2.12.4",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.0",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
